# ynoslop configuration. All variables are optional — defaults suit local use.
# Only `make eval` and `make assemble` read these; the site is static.

# Content locations. Default to the evals/ and skills/ dirs next to src/.
# Allowed models live in models.json at the component root (not an env var) —
# model strings become CLI argv and are whitelisted against that file.
YNOSLOP_EVALS_DIR=
YNOSLOP_SKILLS_DIR=

# Hard timeout for one CLI run (ms). The process is killed when exceeded.
YNOSLOP_RUN_TIMEOUT_MS=300000

# Working directory for spawned CLIs. Leave EMPTY — the default is a private
# per-process directory carrying instruction-file sentinels and a config that
# disables every tool, so the composed prompt is the only instruction a run
# gets. The shared OS temp dir is not a safe value: runners walk up from cwd
# looking for AGENTS.md, so anything that lands there joins every prompt.
YNOSLOP_WORK_DIR=

# Any non-empty value enables debug logging.
YNOSLOP_DEBUG=
